{
  "name": "open-zoho-tui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @open-zoho-tui/core && npm run build --workspace @open-zoho-tui/zoho-client && npm run build --workspace @company/open-zoho-tui && npm run build --workspace @open-zoho-tui/broker",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "dev:cli": "tsx packages/cli/src/index.ts",
    "dev:broker": "tsx packages/broker/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@open-zoho-tui/broker": "*",
    "@open-zoho-tui/core": "*",
    "@open-zoho-tui/zoho-client": "*"
  }
}
